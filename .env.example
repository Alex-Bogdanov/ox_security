MONGO_URI="mongodb://localhost:27017"
MONGO_DB="intelligence_scanner"

RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
SCAN_QUEUE_NAME="npm.scan.jobs"

NPM_REGISTRY_URL="https://registry.npmjs.org"
NPM_TOP_PACKAGES_URL="https://raw.githubusercontent.com/Meyond/npm-top-1000-packages/refs/heads/main/README.md"
NPM_TOP_PACKAGES_SOURCE_TYPE="meyond-readme"

SCHEDULER_INTERVAL_SECONDS="28800"  # 8 hours
SCHEDULER_PACKAGE_LIMIT="1000"
SCHEDULER_HTTP_TIMEOUT_SECONDS="20.0"
SCHEDULER_QUEUED_JOB_VISIBILITY_TIMEOUT_SECONDS="300"

WORKER_PREFETCH_COUNT="4"
WORKER_HTTP_TIMEOUT_SECONDS="30.0"

SCANNER_MAX_TARBALL_BYTES="52428800"
SCANNER_MAX_FILES="5000"
SCANNER_MAX_FILE_READ_BYTES="1048576"
